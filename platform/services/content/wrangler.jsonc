{
  "name": "studio-content",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studio-content",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PAGES",
      "id": "00000000000000000000000000000001"
    }
  ]
}
